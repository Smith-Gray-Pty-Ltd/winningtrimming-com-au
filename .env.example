# Copy to .env and adjust values for your environment.
#
# Local dev (host) notes:
#   - If running `pnpm dev` directly on the host (not via Docker), point
#     POSTGRES_URI at localhost, e.g.:
#       postgresql://payload:payload_local_pw@localhost:5434/winningtrimming
#     (5434 is the host port mapped in docker-compose.yml).
#   - If running via `docker compose up`, keep the `db` service hostname:
#       postgresql://payload:payload_local_pw@db:5432/winningtrimming

# Postgres connection
POSTGRES_USER=payload
POSTGRES_PASSWORD=payload_local_pw
POSTGRES_DB=winningtrimming
POSTGRES_URI=postgresql://payload:payload_local_pw@db:5432/winningtrimming

# Used to encrypt JWT tokens — generate a new one for production:
#   openssl rand -base64 32
PAYLOAD_SECRET=REPLACE_ME_WITH_A_RANDOM_SECRET

# Public URL (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3010

# Meta Pixel ID (facebook ads conversion tracking) — from Meta Events Manager.
# Leave empty to disable the pixel entirely (safe before it exists).
# NEXT_PUBLIC_META_PIXEL_ID=1089754613236124  # Winning Trimming - Pixel (existing)

# Google Analytics 4 Measurement ID — from analytics.google.com → Admin → Data Streams.
# Leave empty to disable GA4 entirely (safe before it exists).
# NEXT_PUBLIC_GA_ID=G-0EVWRGBKNE  # Winning Trimming GA4 (created 2026-09-08)

# Compose project name (keep as winningtrimming to reuse the OrbStack project)
COMPOSE_PROJECT_NAME=winningtrimming

# ---- Optional: S3 / object storage ----
# When S3_BUCKET is unset, Payload stores uploads on local disk. Set all four
# to enable S3-compatible storage (Cloudflare R2, AWS S3, MinIO, etc.).
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=

# ---- Google Reviews sync ----
# Used by src/scripts/fetch-google-reviews.ts to pull reviews from Google
# Places API into the Reviews collection. Get an API key from the Google
# Cloud Console (enable Places API), and find your Place ID from the Google
# Maps listing URL or the Place ID Finder.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=
# PAYLOAD_ADMIN_EMAIL=admin@winningtrimming.com.au
# PAYLOAD_ADMIN_PASSWORD=

# ---- Email (Google Workspace SMTP) ----
# Used for quote notifications to staff + customer confirmations.
# Generate an App Password at myaccount.google.com → Security → App passwords
# (regular Google password won't work for SMTP).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=service@winningtrimming.com.au
# SMTP_PASSWORD=
# SMTP_FROM=service@winningtrimming.com.au
