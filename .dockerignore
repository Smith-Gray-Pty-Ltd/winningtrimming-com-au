# Version control
.git
.gitignore

# Dependencies (installed inside the container)
node_modules

# Next.js build output
# .next is excluded from dev builds but REQUIRED by Dockerfile.prod
# (which COPYs a pre-built .next into the image). We keep .next in the
# context and rely on the Dockerfile stages to handle it correctly.
out

# Local env (compose injects env via env_file; don't bake secrets into image)
.env
.env.local
.env.*.local

# Payload / storage
# Exclude the old default storage dir, but NEVER exclude public/media —
# those are the seed/upload images that must be in the build context.
storage
/media

# Docker
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml

# Editor / OS
.vscode
.idea
.DS_Store
*.log
npm-debug.log*
.pnpm-debug.log*

# Misc
README.railway.md
railway.toml
railway.build.toml
